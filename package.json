{
  "name": "tessera-code",
  "version": "0.5.1",
  "description": "CLI coding agent powered by OpenCode Go",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.json src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "poc": "tsx scripts/poc.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node bin/tessera-code.js",
    "assets": "tsx --tsconfig tsconfig.json scripts/gen-assets.ts"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/mcp": "^2.0.74",
    "@ai-sdk/openai": "^4.0.92",
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@ai-sdk/provider": "^4.0.27",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "ai": "^7.0.138",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^7.30.0",
    "vitest": "^5.0.4",
    "wrap-ansi": "^10.0.2",
    "zod": "^4.6.7"
  },
  "type": "module",
  "private": true,
  "bin": {
    "tessera-code": "./bin/tessera-code.js"
  },
  "files": [
    "bin",
    "dist/bundle",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  }
}
